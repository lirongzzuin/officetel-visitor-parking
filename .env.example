# ============================================================
# 오피스텔 방문차량 관리 — 환경변수 예시 파일
# 실제 값은 .env.local 에 넣고, 이 파일에는 값을 적지 마세요.
#   cp .env.example .env.local
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리 PC 에이전트 ───────────────────────────────────────
# 에이전트 ↔ 서버 API 인증 토큰 (예: openssl rand -hex 32)
AGENT_TOKEN=
# /api/agent/version 이 알려 줄 최신 에이전트 버전
AGENT_VERSION=1.0.0

# ── Vercel Cron (/api/cron/daily-stats) ───────────────────
CRON_SECRET=

# ── 텔레그램 알림 (미등록 차량 신고 등) ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 관리사무소 안내 문구 ────────────────────────────────────
NEXT_PUBLIC_OFFICE_PHONE=
NEXT_PUBLIC_OFFICE_HOURS=

# ── 운영 정책 ─────────────────────────────────────────────
NEXT_PUBLIC_DAILY_QUOTA=10
NEXT_PUBLIC_PENALTY_LIMIT=10
NEXT_PUBLIC_PENALTY_BAN_DAYS=30

# ── 데모 모드 (시간 제한 해제 — 시연용) ─────────────────────
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
