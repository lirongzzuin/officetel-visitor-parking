# ============================================================
# OO오피스텔 주차 — 환경변수 예시 파일 (.env.example)
# ✅  이 파일은 Git에 커밋해도 안전합니다 (실제 값 없음)
#     .env.local 을 복사해서 실제 값을 채워넣으세요:
#       cp .env.example .env.local
# ============================================================

# ── 앱 기본 설정 ──────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BUILDING_NAME=

# ── 관리사무소 연락처 ──────────────────────────────────────
NEXT_PUBLIC_OFFICE_PHONE=
NEXT_PUBLIC_OFFICE_HOURS=

# ── 주차 운영 정책 ────────────────────────────────────────
NEXT_PUBLIC_VISITOR_START_HOUR=6
NEXT_PUBLIC_VISITOR_END_HOUR=18
NEXT_PUBLIC_NIGHT_START_HOUR=18
NEXT_PUBLIC_DAILY_QUOTA=10
NEXT_PUBLIC_PENALTY_LIMIT=10
NEXT_PUBLIC_PENALTY_BAN_DAYS=30

# ── 데이터베이스 (Supabase) ───────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=     ← 서버사이드 전용, NEXT_PUBLIC_ 붙이지 말 것

# ── 인증 ──────────────────────────────────────────────────
# JWT_SECRET=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# ── 알림 채널 ─────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# ── 차단기 연동 API ───────────────────────────────────────
# GATE_API_URL=
# GATE_API_KEY=

# ── 분석 / 모니터링 ───────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
# SENTRY_DSN=
