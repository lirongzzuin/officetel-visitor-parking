# ========================
# Dependencies
# ========================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ========================
# Next.js build output
# ========================
/.next/
/out/
/build

# ========================
# Environment variables — NEVER commit these
# ========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is safe to commit (no secrets, only key names)

# ========================
# Testing & coverage
# ========================
/coverage
/.nyc_output

# ========================
# Debug logs
# ========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ========================
# OS / Editor artifacts
# ========================
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/settings.json
*.swp
*.swo

# ========================
# Vercel
# ========================
.vercel

# ========================
# TypeScript
# ========================
*.tsbuildinfo
next-env.d.ts

# ========================
# Misc
# ========================
*.pem
.cache
tmp/
